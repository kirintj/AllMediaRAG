# ============================================================
# Agent 智能助手 — 环境变量配置模板
# 复制本文件为 .env 并填入实际值：  cp .env.example .env
# ⚠️  .env 包含敏感信息，切勿提交到版本控制！
# ============================================================

# ---------- LLM 服务 ----------
MIMO_API_KEY=your_api_key_here
MIMO_API_BASE=https://api.siliconflow.cn/v1
MIMO_MODEL=mimo-v2.5

# ---------- Embedding 模型 ----------
EMBEDDING_MODEL_PATH=./models/bge-m3

# ---------- Reranking ----------
# 策略: cohere | bge | hybrid
RERANK_STRATEGY=cohere
COHERE_API_KEY=your_cohere_api_key_here
BGE_RERANKER_PATH=./models/bge-reranker-base
RERANK_TOP_K=20
RERANK_TIMEOUT_MS=250

# ---------- 数据存储 ----------
CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data/knowledge-base

# ---------- 查询扩展 ----------
USE_HYDE=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3

# ---------- 缓存 ----------
USE_CACHE=true
CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL=300
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- 性能 ----------
BATCH_SIZE=32
MAX_WAIT_MS=10
PARALLEL_RETRIEVAL=true

# ---------- 评估 ----------
EVAL_DATASET_PATH=./data/eval_dataset.json
ENABLE_LLM_JUDGE=true
LLM_JUDGE_MODEL=mimo-v2.5

# ---------- 可观测性 ----------
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 告警阈值 ----------
ALERT_LATENCY_THRESHOLD_MS=1000
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_QUALITY_THRESHOLD=0.6

# ---------- 认证（JWT） ----------
# 生产环境请务必更换为随机生成的强密钥！
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=24
ALLOW_REGISTRATION=true

# ---------- CORS ----------
# 生产环境填入实际域名，逗号分隔
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
