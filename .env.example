# ============================================================
# Agent 智能助手 — 环境变量配置模板
# 复制本文件为 .env 并填入实际值：  cp .env.example .env
# ⚠️  .env 包含敏感信息，切勿提交到版本控制！
# ============================================================

# ---------- LLM 服务 ----------
MIMO_API_KEY=your_api_key_here
MIMO_API_BASE=https://api.siliconflow.cn/v1
MIMO_MODEL=mimo-v2.5

# ---------- Embedding 模型 ----------
EMBEDDING_MODEL_PATH=./models/bge-m3

# ---------- Reranking ----------
# 策略: cohere | bge | hybrid | siliconflow
RERANK_STRATEGY=cohere
COHERE_API_KEY=your_cohere_api_key_here
BGE_RERANKER_PATH=./models/bge-reranker-base
RERANK_TOP_K=20
RERANK_TIMEOUT_MS=250

# ---------- SiliconFlow 云 API（可选） ----------
# 用于 Embedding 和 Reranking 的云端推理，替代本地模型
# 免费模型：BAAI/bge-m3 (Embedding) + BAAI/bge-reranker-v2-m3 (Reranker)
# 使用方式：设置 EMBEDDING_PROVIDER=siliconflow + RERANK_STRATEGY=siliconflow
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 数据存储 ----------
CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data/knowledge-base

# ---------- 向量存储后端 ----------
# 可选: chroma | pgvector
VECTOR_STORE_PROVIDER=chroma

# ---------- PostgreSQL（pgvector 模式时必需）----------
DATABASE_URL=                          # 完整 URL，优先级最高
PG_HOST=localhost
PG_PORT=5432
PG_USER=rag_user
PG_PASSWORD=rag_password
PG_DATABASE=rag_db
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=10

# ---------- BM25 持久化目录 ----------
BM25_PERSIST_DIR=                      # 留空时回退到 CHROMA_PERSIST_DIR

# ---------- 查询扩展 ----------
USE_HYDE=true
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3

# ---------- 缓存 ----------
USE_CACHE=true
CACHE_L1_MAX_SIZE=1000
CACHE_L1_TTL=300
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_L2_TTL=600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ---------- OCR（图片/扫描件 PDF 文字识别） ----------
# 提供者: paddle | tesseract | none
OCR_PROVIDER=paddle
OCR_LANG=ch
OCR_USE_GPU=false

# ---------- VLM（视觉语言模型，图表理解） ----------
# 使用 MiMo-v2.5 视觉模型（与 LLM 共用 API key 和 API base）
USE_VLM=true
VLM_MODEL=mimo-v2.5
VLM_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# ---------- VLM Extractor（新版统一提取器，替代 OCR+VLM 分离管线） ----------
# 使用 Qwen-VL-Max 完成版面分析 + OCR + 图表理解，输出结构化 JSON
# 启用后 USE_VLM 和 OCR_PROVIDER 的旧管线自动降级为备用方案
USE_VLM_EXTRACTOR=false
VLM_EXTRACTOR_MODEL=qwen-vl-max
VLM_EXTRACTOR_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_EXTRACTOR_API_KEY=your_dashscope_api_key_here
VLM_EXTRACTOR_MAX_TOKENS=4096
VLM_EXTRACTOR_TIMEOUT=60
VLM_EXTRACTOR_MAX_IMAGE_SIZE=1024

# ---------- 图片存储 ----------
# figure 区域的原图保存到文件系统，查询时附带给多模态 LLM
IMAGE_STORE_ENABLED=true
IMAGE_STORE_DIR=./data/images

# ---------- 查询时多模态生成 ----------
# 检索结果中的 figure chunk 携带原图，发给多模态 LLM 生成更准确的回答
# 需要 USE_VLM_EXTRACTOR=true 才能生效（旧管线不产出 figure chunk）
MULTIMODAL_GENERATION=true
MULTIMODAL_MAX_IMAGES=3

# ---------- 工厂模式（可插拔组件） ----------
# 启用后通过 ProviderFactory 创建组件，支持自定义实现
USE_FACTORY_MODE=false
EMBEDDING_PROVIDER=sentence-transformer    # 可选: sentence-transformer | siliconflow
VECTOR_STORE_PROVIDER=chroma
LLM_PROVIDER=openai-compatible

# ---------- 性能 ----------
BATCH_SIZE=32
MAX_WAIT_MS=10
PARALLEL_RETRIEVAL=true

# ---------- 评估 ----------
EVAL_DATASET_PATH=./data/eval_dataset.json
ENABLE_LLM_JUDGE=true
LLM_JUDGE_MODEL=mimo-v2.5

# ---------- 可观测性 ----------
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- 告警阈值 ----------
ALERT_LATENCY_THRESHOLD_MS=1000
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_QUALITY_THRESHOLD=0.6

# ---------- 认证（JWT） ----------
# ⚠️ 上线前必须更换！运行以下命令生成：
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=24
# 上线后建议关闭注册，防止未授权用户创建账号
ALLOW_REGISTRATION=true

# ---------- CORS ----------
# ⚠️ 上线前必须改为实际域名（逗号分隔），否则前端无法访问 API
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 部署模式 ----------
# 开发环境设为 true 可启用热重载（会占用额外 CPU，启动两个进程）
DEV_RELOAD=false
